# Copy to .env.local for `next dev`.
#
# One Google Cloud API key with these APIs enabled on the project:
#   - Cloud Translation API
#   - Cloud Text-to-Speech API
#   - Cloud Speech-to-Text API
# Create it at: console.cloud.google.com → APIs & Services → Credentials.
# The key stays server-side (used only by the /api/* route handlers).
GOOGLE_API_KEY=your-google-cloud-api-key
